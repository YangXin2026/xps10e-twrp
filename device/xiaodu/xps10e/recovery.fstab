#
# TWRP fstab for xiaodu/xps10e (MT6765, A-only, SAR)
# Paths/partitions taken from the stock recovery ramdisk's etc/recovery.fstab.
#

# <mount point>   <fstype>  <device>                                                     <flags>
/system_root      ext4      /dev/block/platform/bootdevice/by-name/system                flags=display="System";ro;backup=1;wrapped_default

/vendor           ext4      /dev/block/platform/bootdevice/by-name/vendor                flags=display="Vendor";ro;backup=1

/data             ext4      /dev/block/platform/bootdevice/by-name/userdata              flags=display="Data";wipeingui;wipeduringfactoryreset;backup=1;encryptable=footer

/cache            ext4      /dev/block/platform/bootdevice/by-name/cache                 flags=display="Cache";wipeingui

/boot             emmc      /dev/block/platform/bootdevice/by-name/boot                  flags=display="Boot";backup=1;flashimg=1
/recovery         emmc      /dev/block/platform/bootdevice/by-name/recovery              flags=display="Recovery";backup=1;flashimg=1

/nvram            emmc      /dev/block/platform/bootdevice/by-name/nvram                 flags=display="Nvram";backup=1
/proinfo          emmc      /dev/block/platform/bootdevice/by-name/proinfo               flags=display="Proinfo";backup=1
/persistent       emmc      /dev/block/platform/bootdevice/by-name/frp                 flags=display="Persist"
/seccfg           emmc      /dev/block/platform/bootdevice/by-name/seccfg               flags=display="SecCfg"
/misc             emmc      /dev/block/platform/bootdevice/by-name/para                  flags=display="Misc"
/logo             emmc      /dev/block/platform/bootdevice/by-name/logo                  flags=display="Logo"

/bootloader       emmc      /dev/block/platform/bootdevice/by-name/lk                    flags=display="Bootloader"

/external_sd      auto      /devices/platform/externdevice*                              flags=display="MicroSD";storage;wipeingui;removable
/usb_otg          auto      /devices/platform/mt_usb*                                   flags=display="USB-OTG";storage;wipeingui;removable
